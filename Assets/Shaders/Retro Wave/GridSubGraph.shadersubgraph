    "m_FunctionName": "AntiAliasing",
    "m_FunctionSource": "",
    "m_FunctionBody": "const float N = 10.0;\r\nfloat2 w = max(abs(dpdx), abs(dpdy));\r\nfloat2 a = p + 0.5*w;                        \r\nfloat2 b = p - 0.5*w;           \r\nfloat2 i = (floor(a)+min(frac(a)*N,1.0)-\r\nfloor(b)-min(frac(b)*N,1.0))/(N*w);\r\nOut = (1.0-i.x)*(1.0-i.y);\r\n"
}

